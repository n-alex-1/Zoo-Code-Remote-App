	<!-- Setup screen -->
	<string name="setup_title">Zoo Remote – Connection</string>
	<string name="setup_instructions">In VS Code: Settings → “Remote Control” → “Start pairing” (the window stays open for 120 s). Then enter host/IP + port here and tap “Pairing”. The app gives up after at most ~40 s with an error message; in practice it takes only seconds. The emulator reaches the host via 10.0.2.2, a real device via its LAN IP.</string>
